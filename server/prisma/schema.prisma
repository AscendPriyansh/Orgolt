// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts AuthAccount[]

  ownedOrganizations  Organization[] @relation("OrgOwner")
  memberOrganizations Organization[] @relation("OrgMembers")

  ownedBoard Board[] @relation("BoardOwner")
}

model AuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum orgVisibility {
  PUBLIC   @map("PUBLIC")
  PRIVATE  @map("PRIVATE")
  UNLISTED @map("UNLISTED")
}

model Organization {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String        @db.VarChar(100)
  description String        @default("") @db.VarChar(100)
  visibility  orgVisibility @default(PRIVATE)
  members     User[]        @relation("OrgMembers")
  boards      Board[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Board {
  id             String       @id @default(cuid())
  ownerId        String
  owner          User         @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       @db.VarChar(100)
  description    String       @default("") @db.VarChar(100)
  lists          List[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model List {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, position])
}
